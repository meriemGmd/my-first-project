{% extends 'base.html.twig' %}

{% block title %}Anime{% endblock %}

{% block body %}
    <h1>Anime</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ anime.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ anime.name }}</td>
            </tr>
            <tr>
                <th>Year</th>
                <td>{{ anime.year }}</td>
            </tr>
            <tr>
                <th>Synopsis</th>
                <td>{{ anime.synopsis }}</td>
            </tr>
            <tr>
                <th>ImageURL</th>
                <td>{{ anime.imageURL }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_anime_index') }}">back to list</a>

    <a href="{{ path('app_anime_edit', {'id': anime.id}) }}">edit</a>

    {{ include('anime/_delete_form.html.twig') }}
{% endblock %}
