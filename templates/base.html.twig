<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Anime List{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
</head>
<body>
<nav class="navbar navbar-expand navbar-dark bg-dark px-3">
    <a class="navbar-brand" href="{{ path('app_catalogue') }}">Anime List</a>
    <div class="ms-auto d-flex gap-3 align-items-center">
        {% if app.user %}
            <span class="text-light">{{ app.user.email }}</span>
            {% if is_granted('ROLE_ADMIN') %}
                <a class="btn btn-warning btn-sm" href="{{ path('app_admin') }}">Admin</a>
            {% endif %}
            <a class="btn btn-outline-light btn-sm" href="{{ path('app_logout') }}">Se déconnecter</a>
        {% else %}
            <a class="btn btn-outline-light btn-sm" href="{{ path('app_login') }}">Se connecter</a>
            <a class="btn btn-primary btn-sm" href="{{ path('app_register') }}">S'inscrire</a>
        {% endif %}
    </div>
</nav>

<main class="container my-4">
    {% block body %}{% endblock %}
</main>
</body>
</html>
